# ============================================================
#  ตัวอย่างค่า Environment Variables
#  คัดลอกไฟล์นี้เป็น .env.local (สำหรับรันในเครื่อง)
#  หรือกรอกค่าเหล่านี้ในหน้า Settings > Environment Variables ของ Vercel
# ============================================================

# --- รหัสเข้าใช้งานโปรแกรม (Access Code) ---
# ผู้ใช้ต้องกรอกรหัสนี้ก่อนเข้าโปรแกรม  (ค่าเริ่มต้น = 044357246)
APP_ACCESS_CODE=044357246

# --- Google Gemini ---
# ขอ API key ฟรีได้ที่ https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxx
# Flash-Lite เหมาะกับงานรวดเร็วและใช้งานผ่าน Free Tier
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Supabase (ไว้บันทึกแผนการสอน) ---
# หาได้ที่ Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ใช้ secret key หรือ service_role key — เก็บเป็นความลับ ห้ามเผยแพร่
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
